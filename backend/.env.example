# انسخ الملف ده وسميه .env واملأ القيم بتاعتك

# رابط قاعدة البيانات Postgres (من Neon — Dashboard > Connection string)
DATABASE_URL=postgresql://user:password@ep-example-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require

# باسورد لوحة التحكم (غيّره لحاجة قوية)
ADMIN_PASSWORD=change_me_123

# سر لتشفير جلسة الأدمن (اكتب أي نص عشوائي طويل)
JWT_SECRET=replace_with_a_long_random_string

# بيانات بوابة الدفع Paymob (هتلاقيها في لوحة تحكم Paymob بعد فتح حساب تاجر)
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=

# البورت اللي السيرفر هيشتغل عليه
PORT=4000
